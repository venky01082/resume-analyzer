# =========================================================
# AI Off-Campus Job Application Platform - Configuration
# =========================================================

# Database Configuration:
# Leave blank to use zero-config local SQLite (database/job_assistant.db)
# Or provide PostgreSQL / Supabase connection URL for production:
# DATABASE_URL=postgresql://postgres:[PASSWORD]@[HOST]:5432/[DBNAME]
# SUPABASE_URL=https://[PROJECT_ID].supabase.co
# SUPABASE_KEY=[ANON_OR_SERVICE_KEY]
DATABASE_URL=

# Job Search APIs (Optional for live job querying via Adzuna):
# Get credentials at: https://developer.adzuna.com/
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Application Security:
# Generate a secure 32+ character key for production cookies/sessions
APP_SECRET_KEY=your_secret_key_here_min_32_chars

# Optional AI LLM Keys (For enhanced dynamic interview question synthesis & LLM evaluation):
# Platform runs 100% locally with deterministic NLP if left empty.
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=

